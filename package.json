{
  "name": "dabber",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types --lang typescript --local > packages/database/src/database.types.ts",
    "db:diff": "supabase db diff",
    "db:migrations": "supabase migration list"
  },
  "devDependencies": {
    "supabase": "2.117.0"
  }
}
